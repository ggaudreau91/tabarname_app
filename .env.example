# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify Developer App (https://developer.spotify.com/dashboard)
# NOTE: depuis avril 2025, Spotify refuse http://localhost. Utiliser 127.0.0.1.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Server-side encryption key for Spotify refresh tokens
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# App URL — utiliser 127.0.0.1 pour matcher le redirect Spotify en dev
# En prod: https://tabarname.com (ou ton domaine Vercel)
APP_URL=http://127.0.0.1:3000

# UUIDs des joueurs autorisés sur /admin (comma-separated)
# Pour trouver le tien: connecte-toi, va sur /compte, tu verras le début de
# ton UUID — copie-le complet depuis Supabase Dashboard > Auth > Users.
ADMIN_PLAYER_IDS=
